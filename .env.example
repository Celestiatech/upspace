# Public Supabase project URL (for example: https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anonymous client key. Do not use the service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public URL of the production deployment, without a trailing slash.
# For example: https://app.example.com
NEXT_PUBLIC_SITE_URL=
